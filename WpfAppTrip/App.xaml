<Application x:Class="WpfAppTrip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfAppTrip" xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="ButtonTextColor">#43555C</Color>
            <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource ButtonTextColor}"/>

            <!-- Material Design Settings -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <system:String x:Key="ConnectionString">Server=(localdb)\MSSQLLocalDB;Database=TourSurveyDB;Trusted_Connection=True;</system:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>
