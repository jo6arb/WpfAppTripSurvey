<Window x:Class="WpfAppTrip.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppTrip.Views.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:WpfAppTrip.ViewModels"
        mc:Ignorable="d"
        Title="МаршрутМастер" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#E3F2FD"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.Resources>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#2196F3"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхнее меню -->
        <materialDesign:ColorZone Mode="PrimaryMid" 
                                 Padding="16"
                                 Visibility="{Binding IsUserLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">
                    <TextBlock Text="{Binding CurrentUserName}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding LogoutCommand}"
                            Content="Выйти"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateToSurveyCommand}"
                            Content="Опрос"/>
                    
                    <!-- Кнопка администратора -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NavigateToAdminCommand}"
                            Content="Управление пользователями"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Основной контент -->
        <Frame Grid.Row="1" 
               x:Name="MainFrame" 
               NavigationUIVisibility="Hidden"/>
        
        <!-- Приветственная страница -->
        <Grid Grid.Row="1" 
              x:Name="WelcomePage"
              Visibility="{Binding IsWelcomePageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть с изображением и текстом -->
            <StackPanel Grid.Column="0" 
                        Margin="40"
                        VerticalAlignment="Center">

                <Border Width="300" 
                        Height="300" 
                        CornerRadius="20"
                        Background="#E3F2FD"
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="1" 
                                        Direction="270" 
                                        Opacity="0.2"/>
                    </Border.Effect>
                    <Image Source="pack://application:,,,/Images/logo.jpeg" 
                           Stretch="UniformToFill"
                           Margin="30"/>
                </Border>

                <TextBlock Text="Добро пожаловать"
                           HorizontalAlignment="Center" 
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{StaticResource ButtonTextBrush}"
                           Margin="0,0,0,10"/>

                <TextBlock Text="в МаршрутМастер!"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{StaticResource ButtonTextBrush}"
                           Margin="0,0,0,30"/>
            </StackPanel>

            <!-- Правая часть с описанием и кнопкой -->
            <StackPanel Grid.Column="1" 
                        Margin="40"
                        VerticalAlignment="Center">

                <TextBlock TextWrapping="Wrap"
                          TextAlignment="Center"
                          Style="{StaticResource MaterialDesignBody1TextBlock}"
                          Foreground="{StaticResource ButtonTextBrush}"
                          LineHeight="24"
                          Margin="0,0,0,40">
                    <Run Text="Приветствуем вас! Пройдите наш быстрый опрос, чтобы мы могли подобрать идеальный вариант отдыха специально для вас."/>
                    <LineBreak/>
                    <LineBreak/>
                    <Run Text="Экономьте свое время, избавьтесь от стресса принятия решений и получите уникальные персонализированные рекомендации для незабываемого отпуска!"/>
                    <LineBreak/>
                    <LineBreak/>
                    <Run Text="Начнем?"/>
                </TextBlock>

                <Button Content="Пройти опрос"
                        Height="50"
                        FontSize="18"
                        Background="White"
                        Foreground="{StaticResource ButtonTextBrush}"
                        BorderThickness="0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Command="{Binding NavigateToSurveyCommand}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="1" 
                                        Direction="270" 
                                        Opacity="0.2"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
