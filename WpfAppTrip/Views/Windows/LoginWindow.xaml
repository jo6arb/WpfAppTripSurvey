<Window x:Class="WpfAppTrip.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfAppTrip.Views.Windows"
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d"
        Title="МаршрутМастер" Height="700" Width="400"
        Background="#E3F2FD"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Images/Icon.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid>
        <Frame x:Name="MainFrame" 
           NavigationUIVisibility="Hidden">
            <Frame.Content>
                <!-- Основной контент -->
                <StackPanel VerticalAlignment="Center"
                       Margin="30,0">

                    <!-- Логотип и название -->
                    <Border Width="240" 
                        Height="240" 
                        CornerRadius="20"
                        Background="#E3F2FD"
                        Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="1" 
                                        Direction="270" 
                                        Opacity="0.2"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Images/logo.jpeg" 
                           Stretch="UniformToFill"
                           Margin="20"/>
                    </Border>

                    <TextBlock Text="МаршрутМастер"
                           HorizontalAlignment="Center"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{StaticResource ButtonTextBrush}"
                           Margin="0,0,0,100"/>

                    <!-- Кнопки -->
                    <Button Height="45"
                        Content="войти"
                        FontSize="20"
                        Background="White"
                        Foreground="{StaticResource ButtonTextBrush}"
                        BorderThickness="0"
                        FontWeight="Medium"                       
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Click="LoginButton_Click"
                        Margin="0,0,0,25">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="1" 
                                        Direction="270" 
                                        Opacity="0.2"/>
                        </Button.Effect>
                    </Button>

                    <Button Height="45"
                        Content="зарегистрироваться"
                        FontSize="20"
                        Background="White"
                        Foreground="{StaticResource ButtonTextBrush}"
                        BorderThickness="0"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Click="RegisterButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="1" 
                                        Direction="270" 
                                        Opacity="0.2"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Frame.Content>
        </Frame>
    </Grid>
</Window>
