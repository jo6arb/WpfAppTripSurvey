<Page x:Class="WpfAppTrip.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="400"
      Title="Регистрация"
      Loaded="Page_Loaded"
      Background="#E3F2FD">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопка "Назад" -->
        <Button Grid.Row="0"
            HorizontalAlignment="Left"
            Style="{StaticResource MaterialDesignFlatButton}"
            Foreground="{StaticResource ButtonTextBrush}"
            Click="BackButton_Click"
            Margin="20,20,0,0">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ArrowLeft" 
                                   Width="24" 
                                   Height="24"/>
                <TextBlock Text="Назад"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Форма регистрации -->
        <StackPanel Grid.Row="1"
                Margin="30,0"
                VerticalAlignment="Center">

            <TextBlock Text="Зарегистрироваться"
                  Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                  Foreground="{StaticResource ButtonTextBrush}"
                  FontWeight="Medium"
                  Margin="0,0,0,40"/>

            <TextBox x:Name="PhoneTextBox"
                 materialDesign:HintAssist.Hint="Телефон"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Height="56"
                 Text="+7"
                 FontSize="16"
                 TextChanged="ValidateFields"
                 Foreground="{StaticResource ButtonTextBrush}"
                 Margin="0,0,0,20"/>

            <TextBox x:Name="EmailTextBox"
                 materialDesign:HintAssist.Hint="Ваш e-mail"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Height="56"
                 FontSize="16"
                 TextChanged="ValidateFields"
                 Foreground="{StaticResource ButtonTextBrush}"
                 Margin="0,0,0,20"/>

            <PasswordBox x:Name="PasswordBox"
                    materialDesign:HintAssist.Hint="Пароль"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                    Height="56"
                    FontSize="16"
                    PasswordChanged="ValidateFields"
                    Foreground="{StaticResource ButtonTextBrush}"
                    Margin="0,0,0,20"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                    materialDesign:HintAssist.Hint="Повторите пароль"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                    Height="56"
                    FontSize="16"
                    PasswordChanged="ValidateFields"
                    Foreground="{StaticResource ButtonTextBrush}"
                    Margin="0,0,0,40"/>

            <Button x:Name="RegisterButton"
                Content="Зарегистрироваться"
                Height="45"
                FontSize="16"
                Background="White"
                IsEnabled="False"
                Foreground="{StaticResource ButtonTextBrush}"
                BorderThickness="0"
                materialDesign:ElevationAssist.Elevation="Dp1"
                materialDesign:ButtonAssist.CornerRadius="10">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10" 
                                ShadowDepth="1"
                                Direction="270"
                                Opacity="0.2"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Page>
