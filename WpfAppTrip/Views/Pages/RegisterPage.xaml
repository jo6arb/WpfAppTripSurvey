<Page x:Class="WpfAppTrip.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:WpfAppTrip.ViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Регистрация"
      Loaded="Page_Loaded"
      Background="#B3E5FC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Левая декоративная панель -->
        <Border Grid.Column="0" Background="#A1DCFB"/>
        
        <!-- Центральная панель с формой регистрации -->
        <Grid Grid.Column="1" Width="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка "Назад" -->
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    Margin="16,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                       Height="24" 
                                       Width="24"/>
                    <TextBlock Text="Назад"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Форма регистрации -->
            <StackPanel Grid.Row="1"
                    Margin="50,0"
                    VerticalAlignment="Center">

                <TextBlock Text="Зарегистрироваться"
                      FontSize="28"
                      FontWeight="Medium"
                      Margin="0,0,0,40"/>

                <TextBlock Text="Телефон" 
                           Margin="0,0,0,8"
                           FontSize="16"/>
                <TextBox x:Name="PhoneTextBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="54"
                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18"
                     TextChanged="ValidateFields"
                     Margin="0,0,0,20"
                     Background="White"/>

                <TextBlock Text="Ваш e-mail" 
                           Margin="0,0,0,8"
                           FontSize="16"/>
                <TextBox x:Name="EmailTextBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="54"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18"
                     TextChanged="ValidateFields"
                     Margin="0,0,0,20"
                     Background="White"/>

                <TextBlock Text="Пароль" 
                           Margin="0,0,0,8"
                           FontSize="16"/>
                <PasswordBox x:Name="PasswordBox"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Height="54"
                        PasswordChanged="ValidateFields"
                        FontSize="18"
                        Margin="0,0,0,20"
                        Background="White"/>

                <TextBlock Text="Повторите пароль" 
                           Margin="0,0,0,8"
                           FontSize="16"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Height="54"
                        PasswordChanged="ValidateFields"
                        FontSize="18"
                        Margin="0,0,0,40"
                        Background="White"/>

                <Button Content="Зарегистрироваться"
                        x:Name="RegisterButton"
                        Click="RegisterButton_Click"
                        Height="54"
                        FontSize="20"
                        Background="White"
                        Foreground="#2196F3"
                        BorderThickness="0"
                        materialDesign:ButtonAssist.CornerRadius="4"/>
            </StackPanel>
        </Grid>
        
        <!-- Правая декоративная панель -->
        <Border Grid.Column="2" Background="#A1DCFB"/>
    </Grid>
</Page>
