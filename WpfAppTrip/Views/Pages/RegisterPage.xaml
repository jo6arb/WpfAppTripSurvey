<Page x:Class="WpfAppTrip.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:WpfAppTrip.ViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="Регистрация"
      Loaded="Page_Loaded"
      Background="#B3E5FC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Левая декоративная панель -->
        <Border Grid.Column="0" Background="#A1DCFB"/>
        
        <!-- Центральная панель с формой регистрации -->
        <Grid Grid.Column="1" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка "Назад" -->
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    Margin="16,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                       Height="24" 
                                       Width="24"/>
                    <TextBlock Text="Назад"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Форма регистрации -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="50,20,50,20">
                    <TextBlock Text="Зарегистрироваться"
                          FontSize="32"
                          FontWeight="Medium"
                          Margin="0,0,0,30"/>
    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Фамилия" 
                                       Margin="0,0,0,8"
                                       FontSize="16"/>
                            <TextBox x:Name="LastNameTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="54"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 TextChanged="TextBox_TextChanged"
                                 Margin="0,0,0,20"
                                 Background="White"/>
            
                            <TextBlock Text="Имя" 
                                       Margin="0,0,0,8"
                                       FontSize="16"/>
                            <TextBox x:Name="FirstNameTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="54"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 TextChanged="TextBox_TextChanged"
                                 Margin="0,0,0,20"
                                 Background="White"/>
            
                            <TextBlock Text="Отчество" 
                                       Margin="0,0,0,8"
                                       FontSize="16"/>
                            <TextBox x:Name="MiddleNameTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="54"
                                 Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 TextChanged="TextBox_TextChanged"
                                 Margin="0,0,0,20"
                                 Background="White"/>
                        </StackPanel>
                        
                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Ваш e-mail" 
                                       Margin="0,0,0,8"
                                       FontSize="16"/>
                            <TextBox x:Name="EmailTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="54"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 TextChanged="TextBox_TextChanged"
                                 Margin="0,0,0,20"
                                 Background="White"/>
            
                            <TextBlock Text="Телефон" 
                                       Margin="0,0,0,8"
                                       FontSize="16"/>
                            <TextBox x:Name="PhoneTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="54"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 TextChanged="TextBox_TextChanged"
                                 Margin="0,0,0,20"
                                 Background="White"/>
                                 
                            <TextBlock Text="Пароль" 
                                       Margin="0,0,0,8"
                                       FontSize="16"/>
                            <PasswordBox x:Name="PasswordBox"
                                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                    Height="54"
                                    PasswordChanged="PasswordBox_PasswordChanged"
                                    FontSize="18"
                                    Margin="0,0,0,20"
                                    Background="White"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Повторите пароль" 
                               Margin="0,0,0,8"
                               FontSize="16"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                            Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                            Height="54"
                            PasswordChanged="PasswordBox_PasswordChanged"
                            FontSize="18"
                            Margin="0,0,0,30"
                            Background="White"/>

                    <Button Content="Зарегистрироваться"
                            x:Name="RegisterButton"
                            Click="RegisterButton_Click"
                            Height="60"
                            FontSize="22"
                            Background="White"
                            Foreground="#2196F3"
                            BorderThickness="0"
                            Margin="0,10,0,20"
                            materialDesign:ButtonAssist.CornerRadius="4"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <!-- Правая декоративная панель -->
        <Border Grid.Column="2" Background="#A1DCFB"/>
    </Grid>
</Page>
