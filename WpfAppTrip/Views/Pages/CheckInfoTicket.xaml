<Page x:Class="WpfAppTrip.Views.Pages.CheckInfoTicket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:WpfAppTrip.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      d:DataContext="{d:DesignInstance Type=viewmodels:CheckInfoTicketViewModel}"
      Title="Проверка информации">

    <Page.Resources>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MediumBlueBrush" Color="#90CAF9"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="PinkButtonBrush" Color="#E91E63"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <BooleanConverter x:Key="BooleanConverter"/>
        <InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        
        <!-- Анимация для плавного перехода -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>
        
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
        
        <!-- Триггеры для анимации -->
        <Style x:Key="FadeInStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}" 
                        Command="{Binding BackCommand}"
                        ToolTip="Назад">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>
                <TextBlock Text="Проверьте информацию" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <materialDesign:Card Margin="32" MaxWidth="800" HorizontalAlignment="Center" UniformCornerRadius="15" Background="{StaticResource LightBlueBrush}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок "Проверьте информацию" -->
                    <TextBlock Grid.Row="0" 
                               Text="Проверьте информацию" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Информация о маршруте -->
                    <Border Grid.Row="1" 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Airplane" 
                                                       Width="24" 
                                                       Height="24" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding RouteInfo}" 
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" 
                                       Text="{Binding ClassInfo}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Margin="32,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Информация о пассажире -->
                    <Border Grid.Row="2" 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="Пассажиры" 
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" 
                                       Text="{Binding PassengerFullName}" 
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" 
                                       Text="{Binding PassengerBirthDate}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Margin="0,0,0,4"/>

                            <StackPanel Grid.Row="3" Orientation="Vertical">
                                <TextBlock Text="{Binding PassengerDocumentInfo}" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                <TextBlock Text="{Binding PassengerDocumentExpiry, StringFormat='Срок действия: {0}'}" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Информация о покупателе -->
                    <Border Grid.Row="3" 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="Покупатель" 
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" 
                                       Text="{Binding BuyerFullName}" 
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" 
                                       Text="{Binding BuyerBirthDate}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Margin="0,0,0,4"/>

                            <StackPanel Grid.Row="3" Orientation="Vertical">
                                <TextBlock Text="{Binding BuyerDocumentInfo}" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                <TextBlock Text="{Binding BuyerDocumentExpiry, StringFormat='Срок действия: {0}'}" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Способ оплаты -->
                    <TextBlock Grid.Row="4" 
                               Text="Способ оплаты" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- СБП -->
                        <Border Grid.Column="0" 
                                Background="White" 
                                BorderBrush="{Binding IsSbpSelected, Converter={StaticResource BooleanConverter}, ConverterParameter='{StaticResource GreenBrush}|{StaticResource BorderBrush}'}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="0,0,4,0"
                                MouseDown="OnSbpSelected">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" 
                                       Source="/Assets/Images/sbp_logo.png" 
                                       Width="32" 
                                       Height="32"
                                       Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="1" 
                                           Text="Система быстрых платежей" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <materialDesign:PackIcon Grid.Column="2" 
                                                       Kind="Check" 
                                                       Foreground="{StaticResource GreenBrush}"
                                                       Width="24" 
                                                       Height="24"
                                                       Visibility="{Binding IsSbpSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Банковская карта -->
                        <Border Grid.Column="1" 
                                Background="White" 
                                BorderBrush="{Binding IsCardSelected, Converter={StaticResource BooleanConverter}, ConverterParameter='{StaticResource GreenBrush}|{StaticResource BorderBrush}'}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="4,0,0,0"
                                MouseDown="OnCardSelected">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" 
                                                       Kind="CreditCard" 
                                                       Width="32" 
                                                       Height="32"
                                                       Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="1" 
                                           Text="Банковская карта" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           VerticalAlignment="Center"/>

                                <materialDesign:PackIcon Grid.Column="2" 
                                                       Kind="Check" 
                                                       Foreground="{StaticResource GreenBrush}"
                                                       Width="24" 
                                                       Height="24"
                                                       Visibility="{Binding IsCardSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Итоговая цена и кнопка оплаты -->
                    <Grid Grid.Row="6" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalPriceFormatted}" 
                                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                       FontWeight="Bold"/>
                            <TextBlock Text=" за 1 пассажира" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2"/>
                        </StackPanel>

                        <Button Grid.Row="1" 
                                Content="Оплатить" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PinkButtonBrush}"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,8"
                                Padding="32,8"
                                Command="{Binding PayCommand}"/>

                        <TextBlock Grid.Row="2" 
                                   Text="Нажимая «Оплатить», вы соглашаетесь с правилами применения выбранного тарифа. В цену включен сервисный сбор." 
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Opacity="0.7"
                                   Margin="0,0,0,8"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </ScrollViewer>
    </Grid>
</Page>
