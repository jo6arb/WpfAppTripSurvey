<Page x:Class="WpfAppTrip.Views.Pages.Tours"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewmodels="clr-namespace:WpfAppTrip.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Tours">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tours}" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,0,20" UniformCornerRadius="15">
                            <Grid>
                                <Button Command="{Binding DataContext.SelectTourCommand, 
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Panel.ZIndex="1"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="250"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Image Source="{Binding ImagePath}" 
                                           Stretch="UniformToFill" 
                                           Height="250"/>

                                    <Grid Grid.Row="1" Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="{Binding Name}" 
                                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Description}" 
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                   Margin="0,0,0,16"/>

                                        <StackPanel Grid.Row="2" 
                                                    Orientation="Horizontal" 
                                                    Margin="0,0,0,16">
                                            <TextBlock Text="Длительность: " 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                            <TextBlock Text="{Binding Duration}" 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                            <TextBlock Text=" дней" 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                            
                                            <TextBlock Text=" | Сложность: " 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                       Margin="16,0,0,0"/>
                                            <TextBlock Text="{Binding Difficulty}" 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                            
                                            <TextBlock Text=" | Сезон: " 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                       Margin="16,0,0,0"/>
                                            <TextBlock Text="{Binding Season}" 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                        </StackPanel>

                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Цена: " 
                                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                                                <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" 
                                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Забронировать сейчас"
                                                    Command="{Binding DataContext.BookTourCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatSecondaryButton}"
                                                    Visibility="{Binding IsSelected, 
                                                              Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <materialDesign:Card.Style>
                                <Style TargetType="materialDesign:Card">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:Card.Style>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <materialDesign:Card 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Padding="32"
            materialDesign:ElevationAssist.Elevation="Dp4"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <ProgressBar 
                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Value="0"
                    IsIndeterminate="True"/>
                <TextBlock 
                    Text="Загрузка туров..."
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page>
