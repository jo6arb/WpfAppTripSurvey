<Page x:Class="WpfAppTrip.Views.Pages.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:WpfAppTrip.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Добро пожаловать"
      Background="#B3E5FC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Logo column -->
            <ColumnDefinition Width="Auto"/>
            <!-- Text and button column -->
            <ColumnDefinition Width="*"/>
            <!-- Empty column -->
        </Grid.ColumnDefinitions>

        <!-- Левая панель с логотипом -->
        <Border Grid.Column="0"  Background="#A1DCFB" Padding="20">
        </Border>

        <!-- Центральный блок с текстом и кнопкой -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20">
            <!-- Изображение -->
            <Image            Stretch="Uniform" Source="/Images/logo.jpeg" Margin="0,0,0,20" Height="300"/>
            <TextBlock Text="Добро пожаловать в МаршрутМастер!"
                       HorizontalAlignment="Center"
                       FontSize="36"
                       FontWeight="Medium"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Приветствуем вас! Пройдите наш быстрый опрос, чтобы мы могли подобрать идеальный вариант отдыха специально для вас."
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Margin="0,0,0,40"/>

            <Button x:Name="StartSurveyButton"
                    Height="54"
                    Width="300"
                    Content="Пройти опрос"
                    FontSize="20"
                    Background="White"
                    Foreground="#2196F3"
                    BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="4"
                    Click="StartSurveyButton_Click"/>
        </StackPanel>

        <!-- Правая декоративная панель -->
        <Border Grid.Column="2" Background="#A1DCFB"/>
    </Grid>
</Page> 