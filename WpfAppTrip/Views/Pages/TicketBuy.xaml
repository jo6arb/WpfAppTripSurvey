<Page x:Class="WpfAppTrip.Views.Pages.TicketBuy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Покупка билета">

    <Page.Resources>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MediumBlueBrush" Color="#90CAF9"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="PinkButtonBrush" Color="#E91E63"/>
        <SolidColorBrush x:Key="GreenToggleBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ConsentTextBrush" Color="#2196F3"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}" 
                        Command="{Binding BackCommand}"
                        ToolTip="Назад">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>
                <TextBlock Text="Покупка билета" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <materialDesign:Card Margin="32" UniformCornerRadius="8" Background="{StaticResource LightBlueBrush}">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Информация о маршруте -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <materialDesign:PackIcon Kind="Airplane" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding RouteInfo, FallbackValue='Москва - Пхукет'}" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ClassInfo, FallbackValue='8 июль, 1 класс Эконом'}" 
                                           Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Итоговая цена -->
                        <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="16,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalPriceFormatted, FallbackValue='185.282₽'}" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                           FontWeight="Bold"/>
                                <TextBlock Text="за 1 пассажира" 
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <Separator Grid.Row="1" Margin="0,16,0,16"/>
                    
                    <!-- Информация о пассажире -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Пассажир" 
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                                   FontWeight="Medium" 
                                   Margin="0,0,0,16"/>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Фамилия"
                                     Text="{Binding PassengerLastName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,16"/>
                            
                            <TextBox Grid.Column="1" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Имя"
                                     Text="{Binding PassengerFirstName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,16"/>
                        </Grid>
                        
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Пол"
                                      SelectedValue="{Binding PassengerGender, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,8,16">
                                <ComboBoxItem Content="муж."/>
                                <ComboBoxItem Content="жен."/>
                            </ComboBox>
                            
                            <DatePicker Grid.Column="1"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:HintAssist.Hint="Дата рождения"
                                        SelectedDate="{Binding PassengerBirthDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="8,0,0,16"/>
                        </Grid>
                        
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Документ"
                                      SelectedValue="{Binding DocumentType, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,8,16">
                                <ComboBoxItem Content="Загранпаспорт РФ"/>
                                <ComboBoxItem Content="Паспорт РФ"/>
                            </ComboBox>
                            
                            <TextBox Grid.Column="1" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Серия и номер"
                                     Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,8,16"/>
                            
                            <TextBox Grid.Column="2" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Срок действия"
                                     Text="{Binding DocumentExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,16"/>
                        </Grid>
                    </Grid>
                    
                    <Separator Grid.Row="3" Margin="0,0,0,16"/>
                    
                    <!-- Информация о покупателе -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,16">
                            <TextBlock Text="Покупатель" 
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                                       FontWeight="Medium"/>
                            <TextBlock Text="Отправим билет, сообщим об изменениях" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Фамилия"
                                     Text="{Binding BuyerLastName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,16"/>
                            
                            <TextBox Grid.Column="1" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Имя"
                                     Text="{Binding BuyerFirstName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,16"/>
                        </Grid>
                        
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Электронная почта"
                                     Text="{Binding BuyerEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,16"/>
                            
                            <TextBox Grid.Column="1" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Телефон"
                                     Text="{Binding BuyerPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="8,0,0,16"/>
                        </Grid>
                        
                        <!-- Согласие на обработку данных -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,24">
                            <CheckBox Style="{StaticResource MaterialDesignCheckBox}" 
                                      IsChecked="{Binding IsConsentGiven, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,8,0"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Даю "/>
                                <Run Text="согласие" Foreground="{StaticResource ConsentTextBrush}"/>
                                <Run Text=" на обработку персональных данных"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Кнопка продолжить -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Нажимая 'Продолжить', вы соглашаетесь с публичной офертой. В цену включен сервисный сбор." 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"/>
                            
                            <Button Grid.Column="1" 
                                    Content="Продолжить" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource PinkButtonBrush}"
                                    Foreground="White"
                                    Height="40"
                                    MinWidth="200"
                                    Command="{Binding ContinueCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </ScrollViewer>
    </Grid>
</Page>
