<Page x:Class="WpfAppTrip.Views.Pages.TicketsHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="История билетов">

    <Page.Resources>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MediumBlueBrush" Color="#90CAF9"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="PinkButtonBrush" Color="#E91E63"/>
        <SolidColorBrush x:Key="GreenToggleBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Command="{Binding BackCommand}"
                            ToolTip="Назад">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>
                    <TextBlock Text="История билетов" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                               VerticalAlignment="Center" 
                               Margin="16,0,0,0"/>
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Style="{StaticResource MaterialDesignIconButton}" 
                        Command="{Binding RefreshCommand}"
                        ToolTip="Обновить">
                    <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                </Button>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <!-- Индикатор загрузки -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" 
                                 IsIndeterminate="True" 
                                 Width="50" 
                                 Height="50"/>
                    <TextBlock Text="Загрузка билетов..." 
                               Style="{StaticResource MaterialDesignBody1TextBlock}" 
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
            
            <!-- Список билетов -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <!-- Сообщение, если нет билетов -->
                <TextBlock Text="У вас пока нет билетов" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Visibility="{Binding Tickets.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                
                <!-- Список билетов -->
                <ListView ItemsSource="{Binding Tickets}" 
                          SelectedItem="{Binding SelectedTicket}"
                          Margin="16"
                          Visibility="{Binding Tickets.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="8" UniformCornerRadius="8" Background="{StaticResource LightBlueBrush}">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Информация о маршруте -->
                                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                        <materialDesign:PackIcon Kind="Airplane" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RouteInfo}" 
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ClassInfo}" 
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Номер билета и дата -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TicketNumber}" 
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PurchaseDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Информация о пассажире -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                        <TextBlock Text="Пассажир:" 
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PassengerLastName, StringFormat='{}{0} '}" 
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding PassengerFirstName}"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <!-- Кнопка открыть билет -->
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Content="Открыть билет" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="{StaticResource DarkBlueBrush}"
                                            HorizontalAlignment="Right"
                                            Margin="0,16,0,0"
                                            Command="{Binding DataContext.OpenTicketCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page> 