<Page x:Class="WpfAppTrip.Views.Pages.CabinetExt"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:WpfAppTrip.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="300"
      Title="Профиль пользователя">

    <Grid Background="#E3F2FD">
        <StackPanel Margin="20">
            <!-- Аватар пользователя -->
            <Border Width="80" Height="80" 
                    CornerRadius="40" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,10">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/default_avatar.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Поля профиля -->
            <Border Background="White" 
                    CornerRadius="8" 
                    Margin="0,5,0,5"
                    Padding="10">
                <TextBox Text="{Binding Username, Mode=TwoWay}" 
                         materialDesign:HintAssist.Hint="ФИО"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         BorderThickness="1"
                         Margin="0,5"/>
            </Border>
            
            <Border Background="White" 
                    CornerRadius="8" 
                    Margin="0,5,0,5"
                    Padding="10">
                <TextBox Text="{Binding Phone, Mode=TwoWay}" 
                         materialDesign:HintAssist.Hint="Телефон"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         BorderThickness="1"
                         Margin="0,5"/>
            </Border>
            
            <Border Background="White" 
                    CornerRadius="8" 
                    Margin="0,5,0,5"
                    Padding="10">
                <TextBox Text="{Binding Email, Mode=TwoWay}" 
                         materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         BorderThickness="1"
                         Margin="0,5"/>
            </Border>
            
            <!-- Кнопка сохранения изменений -->
            <Button Content="Сохранить изменения"
                    Command="{Binding SaveChangesCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#2196F3"
                    Foreground="White"
                    Margin="0,20,0,10"/>
            
            <!-- Кнопка выхода из профиля -->
            <Button Content="Выйти из профиля"
                    Command="{Binding LogoutCommand}"
                    Foreground="Red"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
