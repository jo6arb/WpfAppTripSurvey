<Page x:Class="WpfAppTrip.Views.Pages.CabinetExt"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:WpfAppTrip.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="300"
      Title="Профиль пользователя">

    <Grid Background="#E3F2FD">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Аватар пользователя -->
                <Border Width="80" Height="80" 
                        CornerRadius="40" 
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10">
                    <Border.Background>
                        <ImageBrush ImageSource="/Images/default_avatar.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Поля профиля -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Margin="0,5,0,5"
                        Padding="10">
                    <TextBox Text="{Binding Username, Mode=TwoWay}" 
                             materialDesign:HintAssist.Hint="ФИО"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             BorderThickness="1"
                             Margin="0,5"/>
                </Border>
                
                <Border Background="White" 
                        CornerRadius="8" 
                        Margin="0,5,0,5"
                        Padding="10">
                    <TextBox Text="{Binding Phone, Mode=TwoWay}" 
                             materialDesign:HintAssist.Hint="Телефон"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             BorderThickness="1"
                             Margin="0,5"/>
                </Border>
                
                <Border Background="White" 
                        CornerRadius="8" 
                        Margin="0,5,0,5"
                        Padding="10">
                    <TextBox Text="{Binding Email, Mode=TwoWay}" 
                             materialDesign:HintAssist.Hint="Email"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             BorderThickness="1"
                             Margin="0,5"/>
                </Border>
                
                <!-- Кнопка сохранения изменений -->
                <Button Content="Сохранить изменения"
                        Command="{Binding SaveChangesCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#2196F3"
                        Foreground="White"
                        Margin="0,20,0,10"/>
                
                <!-- Секция "Мои билеты" -->
                <TextBlock Text="Мои билеты" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0,20,0,10"/>
                
                <!-- Список билетов (если есть) -->
                <ItemsControl ItemsSource="{Binding UserTickets}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    CornerRadius="8" 
                                    Margin="0,0,0,10" 
                                    Padding="10"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1">
                                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        Command="{Binding DataContext.OpenTicketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Иконка PDF -->
                                        <materialDesign:PackIcon Kind="FilePdfBox" 
                                                                Width="32" 
                                                                Height="32" 
                                                                Foreground="#E53935"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,10,0"/>
                                        
                                        <!-- Информация о билете -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding TicketNumber}" 
                                                       FontWeight="Bold"
                                                       Foreground="#333333"/>
                                            <TextBlock Text="{Binding RouteInfo}" 
                                                       Foreground="#666666"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PurchaseDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                                       Foreground="#999999"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Сообщение, если нет билетов -->
                <TextBlock Text="У вас пока нет билетов" 
                           HorizontalAlignment="Center"
                           Foreground="#666666"
                           Margin="0,0,0,20"
                           Visibility="{Binding UserTickets.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                
                <!-- Кнопки действий -->
                <StackPanel Margin="0,10,0,20">
                    <Button Content="Все билеты" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource DarkBlueBrush}"
                            Foreground="White"
                            Margin="0,0,0,16"
                            Command="{Binding NavigateToTicketsHistoryCommand}"/>

                    
                    <!-- Кнопка выхода из аккаунта -->
                    <Button Content="Выйти из аккаунта" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PinkButtonBrush}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
