<Page x:Class="WpfAppTrip.Views.Pages.Tickets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppTrip.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Бронирование билетов">

    <Page.Resources>
        <SolidColorBrush x:Key="LightBlueBrush" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MediumBlueBrush" Color="#90CAF9"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="PinkButtonBrush" Color="#E91E63"/>
        <SolidColorBrush x:Key="GreenToggleBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="CovidTagBrush" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="AirportTagBrush" Color="#E0E0E0"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}" 
                        Command="{Binding BackCommand}"
                        ToolTip="Назад">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>
                <TextBlock Text="Бронирование билетов" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Информация о маршруте и пассажирах -->
                <StackPanel Grid.Row="0" Margin="16,16,16,0">
                    <TextBlock Text="{Binding SelectedFlight.Route, FallbackValue='MOW - HKT - MOW'}" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                               FontWeight="Medium"/>
                    <TextBlock Text="{Binding SelectedFlight.DateRange, FallbackValue='ПТН 8 июль - ПТ 19 июль'}" 
                               Style="{StaticResource MaterialDesignBody2TextBlock}" 
                               Margin="0,4,0,8"/>
                    
                    <!-- Информация о пассажирах -->
                    <Border Background="White" 
                            BorderBrush="{StaticResource MediumBlueBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="12,8" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <materialDesign:PackIcon Kind="Account" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" 
                                     Text="1 пассажир, эконом" 
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2" 
                                  Style="{StaticResource MaterialDesignIconButton}" 
                                  Width="24" Height="24" 
                                  Padding="0">
                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Найдено билетов -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Найдено 397 билетов" 
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                  ToolTip="Фильтры">
                                <materialDesign:PackIcon Kind="Filter" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                  ToolTip="Сортировка">
                                <materialDesign:PackIcon Kind="Sort" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Список вариантов билетов -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding FlightOptions}" Margin="16,0,16,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,16" 
                                               UniformCornerRadius="8" 
                                               Background="{StaticResource LightBlueBrush}">
                                <StackPanel>
                                    <!-- Основная информация о рейсе -->
                                    <Grid Margin="16,16,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0}₽, FallbackValue=57 657₽}" 
                                                 Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                                 FontWeight="Bold"/>
                                        
                                        <Button Grid.Column="1" 
                                              Style="{StaticResource MaterialDesignIconButton}" 
                                              Background="Red" 
                                              Foreground="White">
                                            <materialDesign:PackIcon Kind="Heart" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Информация о рейсе туда -->
                                    <Grid Margin="16,8,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Время вылета и аэропорт -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding DepartureTime, FallbackValue=04:45}" 
                                                     Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
                                            <TextBlock Text="{Binding DepartureAirport, FallbackValue=MOW}" 
                                                     Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                     Foreground="Gray"/>
                                        </StackPanel>
                                        
                                        <!-- Информация о пересадках -->
                                        <StackPanel Grid.Column="1" Margin="16,0">
                                            <TextBlock Text="{Binding TravelTime, FallbackValue=58ч в пути}" 
                                                     Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                                     HorizontalAlignment="Center"/>
                                            <Border Height="1" 
                                                  Background="Gray" 
                                                  Margin="0,4"/>
                                            <TextBlock Text="{Binding Transfers, FallbackValue=1 пересадка}" 
                                                     Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                                     HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Время прилета и аэропорт -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding ArrivalTime, FallbackValue=15:20}" 
                                                     Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                                                     HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ArrivalAirport, FallbackValue=HKT}" 
                                                     Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                     Foreground="Gray" 
                                                     HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Информация об аэропортах -->
                                    <TextBlock Text="{Binding TransferAirports, FallbackValue='IST (Новый Аэропорт Стамбула)'}" 
                                             Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                             Margin="16,4,16,8" 
                                             HorizontalAlignment="Center" 
                                             Foreground="Gray"/>
                                    
                                    <!-- Дополнительные опции -->
                                    <Grid Margin="16,8,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="Добавить багаж" 
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                 VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding BaggagePrice, StringFormat=+{0:N0}₽, FallbackValue=+7 625₽}" 
                                                     Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,8,0"/>
                                            <ToggleButton Background="{StaticResource GreenToggleBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Теги -->
                                    <StackPanel Orientation="Horizontal" Margin="16,12,16,0">
                                        <Border Background="{StaticResource CovidTagBrush}" 
                                              CornerRadius="4" 
                                              Padding="8,4">
                                            <TextBlock Text="covid" 
                                                     Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        </Border>
                                        <Border Background="{StaticResource AirportTagBrush}" 
                                              CornerRadius="4" 
                                              Padding="8,4" 
                                              Margin="8,0,0,0">
                                            <TextBlock Text="Смена аэропорта" 
                                                     Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Дополнительный багаж -->
                                    <Grid Margin="16,12,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="Добавить багаж" 
                                                 Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                 VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="+8 853 ₽" 
                                                     Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,8,0"/>
                                            <ToggleButton/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Кнопка покупки -->
                                    <Button Content="{Binding BuyButtonText, FallbackValue='Купить'}" 
                                          Style="{StaticResource MaterialDesignRaisedButton}" 
                                          Background="{StaticResource PinkButtonBrush}" 
                                          Foreground="White"
                                          HorizontalAlignment="Stretch" 
                                          Margin="16,16,16,16"
                                          Height="40"
                                          Command="{Binding DataContext.BookFlightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
